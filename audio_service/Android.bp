package {
    default_team: "trendy_team_android_media_audio_framework",
}

cc_binary {
    name: "android.hardware.audio.service.exynos",

    init_rc: ["android.hardware.audio.service.exynos.rc"],
    relative_install_path: "hw",
    vendor: true,

    // Match the 32-bit primary HAL and HIDL implementations in device-common.mk.
    compile_multilib: "32",

    srcs: ["service.cpp"],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],

    shared_libs: [
        "libcutils",
        "libbinder",
        "libbinder_ndk",
        "libhidlbase",
        "liblog",
        "libutils",
        "libhardware",
    ],
}
